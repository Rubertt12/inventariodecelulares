{
  "name": "inventario-celulares",
  "version": "1.1.1",
  "description": "API para o sistema de gerenciamento de celulares.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "br.com.voke.inventariocelulares",
    "productName": "Inventario de Celulares VOKE",
    "asar": true,
    "files": [
      "desktop/**",
      "app.js",
      "celular.rubertt.html",
      "style.css",
      "sw.js",
      "manifest.json",
      "icon.svg",
      "geradordetermoprojetov1.html",
      "Gerador_Caixa_Etiqueta.html",
      "zebra/zebra.html",
      "coletor-celulares.html"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "IMG/favicon_opcao_A.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-builder@26.18.0": true
  }
}
